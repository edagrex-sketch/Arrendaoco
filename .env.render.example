# ============================================
# Render + Aiven MySQL - Variables de entorno
# ============================================
# 1. Crea una cuenta gratis en https://aiven.io
# 2. Crea un servicio MySQL (Free plan, 1GB)
# 3. Activa "Allow all IPs" en Aiven o agrega la IP de Render
# 4. Copia los datos de conexión aquí abajo
# ============================================

APP_NAME=ArrendaOco
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://arrendaoco.onrender.com

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=<HOST>.aivencloud.com
DB_PORT=3306
DB_DATABASE=arrendaoco_prod
DB_USERNAME=avnadmin
DB_PASSWORD=<tu_password_de_aiven>

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

BROADCAST_CONNECTION=log

MAIL_MAILER=log
